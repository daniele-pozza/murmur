<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Murmur</string>
	<key>CFBundleDisplayName</key>
	<string>Murmur</string>
	<!-- Display name only is "Murmur". The executable deliberately is NOT: it stays
	     space-free and distinct so `pkill -x`/`killall` can never match another
	     dictation app's `murmur` binary if one is ever installed alongside. -->
	<key>CFBundleExecutable</key>
	<string>MurmurYouTube</string>
	<!-- Never rename this. TCC keys the Accessibility and Microphone grants to the
	     bundle ID, so changing it silently revokes both and re-prompts from scratch.
	     Also keeps a distinct preferences domain from any com.murmur.client. -->
	<key>CFBundleIdentifier</key>
	<string>ai.pivotstudio.murmur-youtube</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<!-- A regular app: dock icon, app menu, standard windows. The menu bar item remains
	     for status and the hotkey while you're working elsewhere, but it is secondary. -->
	<key>LSUIElement</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Murmur listens while dictation is active so it can turn your speech into text.</string>
</dict>
</plist>
